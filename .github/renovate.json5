{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':automergeBranch',
    ':disableRateLimiting',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard',
  assigneesFromCodeOwners: true,
  ignoreTests: true,
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.yaml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.yaml$/',
    ],
  },
  packageRules: [
    {
      description: 'Group PaperMC server version updates',
      matchDatasources: [
        'custom.papermc',
      ],
      groupName: 'papermc',
    },
    {
      description: 'Group rook-ceph helm charts',
      groupName: 'rook-ceph',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        '/rook-ceph/',
      ],
    },
    {
      description: 'Group rclone container updates',
      groupName: 'rclone',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/ghcr.io/rclone/rclone/',
      ],
    },
    {
      description: 'Group immich across ansible and kubernetes',
      groupName: 'immich',
      matchPackageNames: [
        'immich',
        'immich-app/immich',
      ],
      commitMessagePrefix: 'fix(deps): ',
    },
    {
      description: 'Group immich-folder-album-creator across ansible and kubernetes',
      groupName: 'immich-folder-album-creator',
      matchPackageNames: [
        '/immich-folder-album-creator/',
      ],
    },
    {
      description: 'Group tdarr and tdarr_node container updates',
      groupName: 'tdarr',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/ghcr.io/haveagitgat/tdarr/',
      ],
    },
    {
      description: [
        'Loose versioning for non-semver packages',
      ],
      matchDatasources: [
        'docker',
      ],
      versioning: 'loose',
      matchPackageNames: [
        '/metube/',
        '/plex/',
        '/searxng/',
      ],
    },
    {
      description: 'Version cloudnative-vectorchord as PostgreSQL plus extension version',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      allowedVersions: '/^18\\./',
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+))?$',
    },
    {
      description: 'Auto-merge patch and digest updates',
      matchUpdateTypes: [
        'digest',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
    },
    {
      description: 'Auto-merge allowlisted minor updates',
      matchUpdateTypes: [
        'minor',
      ],
      matchPackageNames: [
        '/^ghcr\\.io/davralin/',
        '/^ghcr\\.io/prometheus-community/',
      ],
      automerge: true,
      automergeType: 'branch',
    },
    {
      description: 'Commit messages for Minecraft plugins (github-releases used in pluginUrls)',
      matchDatasources: ['github-releases'],
      matchPackageNames: [
        '/BentoBoxWorld/',
        '/ViaVersion/',
        '/sladkoff/minecraft-prometheus-exporter/',
      ],
      commitMessagePrefix: 'fix(plugin): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      description: 'Commit messages for PaperMC server (major)',
      matchDatasources: ['custom.papermc'],
      matchUpdateTypes: ['major'],
      commitMessagePrefix: 'feat(paper)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      description: 'Commit messages for PaperMC server (minor)',
      matchDatasources: ['custom.papermc'],
      matchUpdateTypes: ['minor'],
      commitMessagePrefix: 'feat(paper): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      description: 'Commit messages for PaperMC server (patch)',
      matchDatasources: ['custom.papermc'],
      matchUpdateTypes: ['patch'],
      commitMessagePrefix: 'fix(paper): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(container)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: ' ( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      commitMessagePrefix: 'feat(container): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: ' ( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      commitMessagePrefix: 'fix(container): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: ' ( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      commitMessagePrefix: 'chore(container): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentDigestShort}} → {{newDigestShort}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(helm)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      commitMessagePrefix: 'feat(helm): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      commitMessagePrefix: 'fix(helm): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(github-action)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      commitMessagePrefix: 'feat(github-action): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      commitMessagePrefix: 'fix(github-action): ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      addLabels: [
        'renovate/grafana-dashboard',
      ],
      automerge: true,
      automergeType: 'branch',
      matchDatasources: [
        'custom.grafana-dashboards',
      ],
      matchUpdateTypes: [
        'major',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'grafana-dashboards',
      commitMessageTopic: 'dashboard {{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
  ],
  customDatasources: {
    'papermc': {
      defaultRegistryUrlTemplate: 'https://fill.papermc.io/v3/projects/paper',
      format: 'json',
      transformTemplates: [
        '{"releases": ($keys(versions).($lookup($$.versions, $)))[$not($contains($, "-"))].{"version": $}}',
      ],
    },
    'grafana-dashboards': {
      defaultRegistryUrlTemplate: 'https://grafana.com/api/dashboards/{{packageName}}',
      format: 'json',
      transformTemplates: [
        '{"releases":[{"version": $string(revision)}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      description: [
        'Process Grafana dashboards',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'depName="(?<depName>.*)"\\n(?<indentation>\\s+)gnetId: (?<packageName>\\d+)\\n.+revision: (?<currentValue>\\d+)',
      ],
      autoReplaceStringTemplate: 'depName="{{{depName}}}"\n{{{indentation}}}gnetId: {{{packageName}}}\n{{{indentation}}}revision: {{{newValue}}}',
      datasourceTemplate: 'custom.grafana-dashboards',
      versioningTemplate: 'regex:^(?<major>\\d+)$',
    },
    {
      customType: 'regex',
      description: [
        'Process CloudnativePG Postgresql version',
      ],
      managerFilePatterns: [
        '/kubernetes/.+\\.yaml$/',
      ],
      matchStrings: [
        '(?<indentation>\\s*)imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>\\d+[^\\s@]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      autoReplaceStringTemplate: '{{{indentation}}}imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}',
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.+)$',
    },
    {
      customType: 'regex',
      description: 'Process Immich helm-chart tags',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n(?<variable>\\w+): (?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Process custom ansible role-dependencies',
      managerFilePatterns: [
        '/(^|/)ansible/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n(?<variable>\\w+): (?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Process GitHub release download URLs for Minecraft plugins',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '(?<commentIndentation>\\s*)# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n(?<indentation>\\s*)(?<linePrefix>- )https://github\\.com/(?<repo>\\S+)/releases/download/(?<tagPrefix>v?)(?<currentValue>[^/\\s]+)/(?<assetPrefix>\\S*?)(?<assetVersionPrefix>v?)\\d+(?:\\.\\d+)*(?<assetSuffix>[^/\\s]*?\\.jar)',
        '(?<commentIndentation>\\s*)# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n(?<indentation>\\s*)(?<linePrefix>value: )https://github\\.com/(?<repo>\\S+)/releases/download/(?<tagPrefix>v?)(?<currentValue>[^/\\s]+)/(?<assetPrefix>\\S*?)(?<assetVersionPrefix>v?)\\d+(?:\\.\\d+)*(?<assetSuffix>[^/\\s]*?\\.jar)',
      ],
      autoReplaceStringTemplate: '{{{commentIndentation}}}# renovate: datasource={{{datasource}}} depName={{{depName}}}\n{{{indentation}}}{{{linePrefix}}}https://github.com/{{{repo}}}/releases/download/{{{tagPrefix}}}{{{newValue}}}/{{{assetPrefix}}}{{{assetVersionPrefix}}}{{{newValue}}}{{{assetSuffix}}}',
      versioningTemplate: 'semver-coerced',
    },
    {
      customType: 'regex',
      description: 'Process PaperMC server versions — wrap in YAML quotes to avoid float parsing',
      datasourceTemplate: 'custom.papermc',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=custom\\.papermc depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n(?<indentation>\\s+)version: (?<currentValue>\\S+)',
      ],
      autoReplaceStringTemplate: '# renovate: datasource=custom.papermc depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n{{{indentation}}}version: "{{{newValue}}}"',
    },
    {
      customType: 'regex',
      description: 'Process custom kubernetes role-dependencies',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s+(?<variable>tag|version|[A-Z][A-Z0-9_]*): (?<currentValue>\\S+)',
      ],
    },
  ],
}
